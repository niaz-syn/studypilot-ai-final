# GEMINI_API_KEY: Required for Gemini AI API calls (Google Gemini API)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted
APP_URL="http://localhost:3000"

# FIREBASE CONFIGURATION (Optional for cloud auth and firestore sync)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="studypilot-ai.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="studypilot-ai"
VITE_FIREBASE_STORAGE_BUCKET="studypilot-ai.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef123456"

# SERVER PORT
PORT=3000

